# Dockerfile kopiuje cały katalog (COPY . .), więc bez tej listy do obrazu
# trafiłyby sekrety i lokalne artefakty.

# Sekrety — klucz prywatny TLS należy do nginx, nie do obrazu aplikacji.
.env
deploy/nginx/ssl/
*.pem

# Lokalne bazy i artefakty. W .dockerignore (inaczej niż w .gitignore)
# wzorzec bez **/ pasuje tylko w katalogu głównym, a __pycache__ powstaje
# w każdym pakiecie. Tryb WAL tworzy obok bazy pliki -wal i -shm.
**/*.db
**/*.db-wal
**/*.db-shm
**/__pycache__/
**/*.pyc
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Historia repozytorium nie jest potrzebna w obrazie
.git/
