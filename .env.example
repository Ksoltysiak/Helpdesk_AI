# WYMAGANE — klucz podpisujacy tokeny JWT.
# Minimum 32 bajty (RFC 7518). Wygeneruj wlasny:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string-in-production

# --- Ustawienia wdrozeniowe (opcjonalne, domyslnie wylaczone) ---

# Przekierowanie HTTP -> HTTPS oraz naglowek HSTS.
# Wlacz dopiero, gdy aplikacja faktycznie ma certyfikat TLS.
# FORCE_HTTPS=1

# Odczytywanie prawdziwego adresu klienta z naglowka X-Forwarded-For.
# Wlacz WYLACZNIE za odwrotnym proxy / load balancerem — w przeciwnym razie
# naglowek mozna podrobic i obejsc limit prob logowania.
# TRUST_PROXY=1

# Wspolny magazyn licznikow limitu zadan. Bez tego kazdy proces gunicorna
# liczy osobno, wiec przy N procesach limit jest N razy wyzszy.
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# Sciezka pliku bazy SQLite (w kontenerze ustawiana przez docker-compose).
# DB_PATH=/app/data/helpdesk.db
